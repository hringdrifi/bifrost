# KiCad local state and automatic backups
*.kicad_prl
*.round-tracks-config
*-backups/
*.bak

# Generated PCB exports, 3D models, and reference images
/pcb/**/*.step
/pcb/**/*.stp
/pcb/**/*.png
/pcb/**/*.jpg
/pcb/**/*.jpeg

# Keep source component models under version control; only exported board models stay ignored.
!/pcb/**/3dmodels/*.step
!/pcb/**/3dmodels/*.stp

# PMW3610 model source and license are not yet confirmed.
/pcb/right_kicad/3dmodels/PMW3610.step

# Third-party component models kept locally for KiCad 3D rendering only.
/pcb/**/3dmodels/9774030243R.stp
/pcb/**/3dmodels/USB_C_Receptacle_HRO_TYPE-C-31-M-12.step
/pcb/**/3dmodels/SW_SPDT_Shouhan_MSK12C02.step
/pcb/**/3dmodels/SW_SMD_2P-TS24CA.step

# OS metadata
.DS_Store
Thumbs.db

# Local Codex and agent workspace state
.codex/
.agents/
