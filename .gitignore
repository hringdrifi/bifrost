# KiCad local state and automatic backups
*.kicad_prl
*-backups/
*.bak

# Generated PCB exports, 3D models, and reference images
/pcb/**/*.step
/pcb/**/*.stp
/pcb/**/*.png
/pcb/**/*.jpg
/pcb/**/*.jpeg

# Keep source component models under version control; only exported board models stay ignored.
!/pcb/**/3dmodels/*.step
!/pcb/**/3dmodels/*.stp

# OS metadata
.DS_Store
Thumbs.db

# Local Codex and agent workspace state
.codex/
.agents/
